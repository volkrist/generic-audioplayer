    <fragment
        android:id="@+id/addSongsToPlaylistFragment"
        android:name="com.generic.audioplayes.playlisteditor.AddSongsToPlaylistFragment"
        android:label="AddSongsToPlaylistFragment" >
        <argument
            android:name="playlistId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/tagEditorFragment"
        android:name="com.generic.audioplayes.tags.TagEditorFragment"
        android:label="TagEditorFragment" >
        <argument
            android:name="songPath"
            app:argType="string" />
