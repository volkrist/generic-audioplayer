        android:name="com.generic.audioplayes.playlisteditor.PlaylistEditorFragment"
        android:label="PlaylistEditorFragment" >
        <argument
            android:name="playlistId"
            app:argType="long" />
        <action
            android:id="@+id/action_playlistEditorFragment_to_addSongsToPlaylistFragment"
            app:destination="@id/addSongsToPlaylistFragment"
            app:enterAnim="@anim/ap_open_enter"
            app:exitAnim="@anim/ap_open_exit"
            app:popEnterAnim="@anim/ap_close_enter"
