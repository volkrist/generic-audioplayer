    <fragment
        android:id="@+id/splashFragment"
        android:name="com.generic.audioplayes.splash.SplashFragment"
        android:label="fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_onBoardingFragment"
            app:destination="@id/onBoardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.generic.audioplayes.onboarding.OnBoardingFragment"
        android:label="OnBoardingFragment" >
        <action
            android:id="@+id/action_onBoardingFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_left_enter"
            app:exitAnim="@anim/slide_left_exit"
            app:popUpTo="@id/onBoardingFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/selectPlaylistFragment"
        android:name="com.generic.audioplayes.select_playlist.SelectPlaylistFragment"
        android:label="SelectPlaylistFragment" >
        <argument
            android:name="songLocations"
            app:argType="string[]" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.generic.audioplayes.search.SearchFragment"
        android:label="SearchFragment" >
        <action
            android:id="@+id/action_searchFragment_to_collectionFragment"
            app:destination="@id/collectionFragment"
            app:enterAnim="@anim/ap_open_enter"
            app:exitAnim="@anim/ap_open_exit"
            app:popEnterAnim="@anim/ap_close_enter"
            app:popExitAnim="@anim/ap_close_exit"/>
        <action
            android:id="@+id/action_searchFragment_to_playlistEditorFragment"
            app:destination="@id/playlistEditorFragment"
            app:enterAnim="@anim/ap_open_enter"
